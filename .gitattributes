# Normalize to LF in the repository; check out native line endings on Windows.
* text=auto

# Source
*.cs        text diff=csharp
*.csproj    text eol=crlf
*.slnx      text eol=crlf
*.props     text eol=crlf
*.targets   text eol=crlf
*.ts        text
*.tsx       text
*.js        text
*.jsx       text
*.json      text
*.css       text
*.html      text
*.md        text

# Shell scripts must stay LF even on Windows
*.sh        text eol=lf

# Windows scripts must stay CRLF
*.bat       text eol=crlf
*.cmd       text eol=crlf
*.ps1       text eol=crlf

# Binary - never diff or normalize
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.svg       text
*.pdf       binary
*.pfx       binary
*.snk       binary
*.dll       binary
*.exe       binary

# Lockfiles: keep diffs but collapse them in PR review
package-lock.json  text -diff linguist-generated
